# ── Game-server (WebSocket + Kafka + agents) — required ────────────────────
# Same Firebase Admin credentials as backend/.env (see ../.env.example)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Anthropic API key — used by Report / Coach / Coaching agents.
# Without it, agents log a warning and skip (no Firestore writes for those flows).
ANTHROPIC_API_KEY=sk-ant-...

# Optional infra
# WS_PORT=3001
# KAFKA_BROKER=localhost:9092
# KAFKA_SSL=true
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=your-password
# KAFKA_SASL_MECHANISM=scram-sha-256

# Optional: token-watcher daily thresholds (total = input + output tokens)
# TOKEN_DAILY_WARNING_THRESHOLD=500000
# TOKEN_DAILY_CRITICAL_THRESHOLD=1000000
