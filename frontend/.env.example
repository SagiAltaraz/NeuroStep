# Frontend environment — copy this file to `.env` and fill in the values.
# These are PUBLIC Firebase web-app config values (safe to expose in the client).
#
# Where to get them:
#   Firebase Console → Project "neurostep-938fa" → Project settings (gear)
#   → General tab → "Your apps" → the Web app → SDK setup and configuration
#   → "Config". Copy apiKey, messagingSenderId, and appId below.
#
# Google sign-in ALSO requires, in the Firebase Console:
#   Authentication → Sign-in method → enable "Google"
#   Authentication → Settings → Authorized domains → add "localhost"
#     (and your production domain).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the API proxy target for local dev (defaults to the backend).
# VITE_API_PROXY_TARGET=http://localhost:3000
