# Copy to ".env" on the server (next to docker-compose.prod.yml) and fill in.
# These feed docker-compose interpolation + the frontend build args.
# Runtime secrets (Firebase admin key, Anthropic key, etc.) live in backend/.env.

# Your domain (buy at Cloudflare). Do NOT include https:// or a path.
DOMAIN=localhost

# Public WebSocket URL the browser connects to — must match the ws subdomain.
VITE_WS_URL=wss://localhost:3001

# Comma-separated origins the REST API accepts (CORS).
# Leave unset to fall back to localhost:3000 defaults.
CORS_ORIGINS=https://localhost

# Public Firebase (client) config — safe to expose, baked into the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
